# InGen Studio — runtime configuration. Copy to `.env` (or `.env.local`) to override.
#
# Adapter mode: "mock" (default; localStorage + simulated runs) or "http" (FastAPI wrapper).
NEXT_PUBLIC_ADAPTER_MODE=mock

# Base URL of the FastAPI wrapper, used only when NEXT_PUBLIC_ADAPTER_MODE=http.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
